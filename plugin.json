{
  "license": "GPL-3.0-or-later",
  "type": "nmos_grid",
  "label": "Grille NMOS",
  "version": "0.7.0",
  "runtime": "docker",
  "requires": [
    {
      "type": "nmos_parc",
      "reason": "parc NMOS partagé"
    }
  ],
  "description": "Routeur logiciel ST 2110 par-dessus NMOS (IS-04 / IS-05) : une grille X/Y sources (senders) × destinations (receivers), lue en parcourant les nodes NMOS fournis par l'outil « Parc NMOS » (repris en lecture seule du parc « Convertisseurs Blackmagic », + nodes manuels). Un croisement actif = le receiver est abonné au sender (état détecté via IS-05 /active). TAKE d'un clic (transportfile SDP du sender → PATCH staged du receiver, activation immédiate), déconnexion, salvos nommés et snapshots du routage complet. SDP intégré à la grille, symétrique : clic sur l'en-tête d'une source ou d'une destination → barre d'actions au-dessus (source : Voir SDP ; destination : Voir le SDP courant / Coller un SDP et abonner). Ergonomie d'affichage : vue « par flux » ou « par signal » (natural grouping BCP-002-01, grouphint + repli heuristique) avec take groupé, repli par équipement, favoris, recherche, mode « câblées uniquement ». Mode simulation intégré (parc démo) pour tester sans matériel.",
  "badge": {
    "label": "GRID",
    "class": "tool-nmosgrid",
    "oklch": "0.70 0.17 300"
  },
  "nav": {
    "section": "reseau",
    "label": "Réseau",
    "order": 15
  },
  "ui": {
    "page_html": "page.html",
    "page_js": "page.js",
    "page_css": "page.css"
  },
  "docker": {
    "image": "bobitool-nmos_grid:0.7.0",
    "build": true,
    "port": 8080,
    "volume": "/data",
    "shared_volumes": [
      {
        "volume": "bobitool-nmos_parc-data",
        "mount": "/parc",
        "ro": true
      }
    ]
  },
  "permissions": [
    {
      "id": "crosspoint.take",
      "label": "Commuter un croisement",
      "default_roles": [
        "operator"
      ],
      "description": "Take, déconnexion (unitaire ou groupée), coller un SDP sur un récepteur."
    },
    {
      "id": "sender.control",
      "label": "Piloter les émetteurs",
      "default_roles": [
        "operator"
      ],
      "description": "Activer / couper un sender, le relancer (bounce) : coupe la source pour tous ses abonnés."
    },
    {
      "id": "salvo.recall",
      "label": "Rappeler un salvo",
      "default_roles": [
        "operator"
      ]
    },
    {
      "id": "snapshot.restore",
      "label": "Restaurer un instantané",
      "default_roles": [
        "operator"
      ],
      "description": "Réapplique tout le routage mémorisé, déconnexions comprises."
    },
    {
      "id": "preset.manage",
      "label": "Gérer salvos et instantanés",
      "default_roles": [
        "operator"
      ],
      "description": "Créer, modifier, supprimer."
    }
  ],
  "acl": {
    "resources": [
      {
        "key": "receiver",
        "label": "Récepteurs",
        "choices": "grid",
        "choices_list": "receivers",
        "choices_id": "key"
      },
      {
        "key": "salvo",
        "label": "Salvos",
        "choices": "salvos",
        "choices_list": "salvos"
      },
      {
        "key": "snapshot",
        "label": "Instantanés",
        "choices": "snapshots",
        "choices_list": "snapshots"
      }
    ],
    "routes": [
      {
        "method": "POST",
        "path": "take",
        "perm": "crosspoint.take",
        "resource": {
          "receiver": "body.receiver_key"
        }
      },
      {
        "method": "POST",
        "path": "apply-sdp",
        "perm": "crosspoint.take",
        "resource": {
          "receiver": "body.receiver_key"
        }
      },
      {
        "method": "POST",
        "path": "disconnect",
        "perm": "crosspoint.take",
        "resource": {
          "receiver": "body.receiver_key"
        }
      },
      {
        "method": "POST",
        "path": "take-group",
        "perm": "crosspoint.take"
      },
      {
        "method": "POST",
        "path": "disconnect-group",
        "perm": "crosspoint.take"
      },
      {
        "method": "POST",
        "path": "bounce",
        "perm": "sender.control"
      },
      {
        "method": "POST",
        "path": "bounce-group",
        "perm": "sender.control"
      },
      {
        "method": "POST",
        "path": "sender-enable",
        "perm": "sender.control"
      },
      {
        "method": "POST",
        "path": "salvos/{salvo}/apply",
        "perm": "salvo.recall",
        "resource": {
          "salvo": "{salvo}"
        }
      },
      {
        "method": "POST",
        "path": "snapshots/{snapshot}/apply",
        "perm": "snapshot.restore",
        "resource": {
          "snapshot": "{snapshot}"
        }
      },
      {
        "method": "*",
        "path": "**",
        "perm": "preset.manage"
      }
    ]
  }
}
